{
  "name": "lizyoko-better-dsh",
  "version": "0.4.2",
  "description": "Personal, opinionated UX improvements for the DeepSeek Harness web client: a browsable folder tab, a Mission Control dashboard for running, waiting and scheduled work, and a font settings panel.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin"
  ],
  "type": "module",
  "license": "MIT",
  "author": "lizyoko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizyoko9/lizyoko-better-dsh.git"
  },
  "homepage": "https://github.com/lizyoko9/lizyoko-better-dsh",
  "bugs": {
    "url": "https://github.com/lizyoko9/lizyoko-better-dsh/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "docs/*.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
